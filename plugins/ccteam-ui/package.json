{
  "name": "@ccteam/ccteam-ui",
  "version": "0.10.4-alpha.0",
  "description": "ccteam inside the DeepSeek Harness: the workbench in DSH web (cross-harness session tree, native-grade chat, one-click spawn), the eight ccteam MCP tools for DSH agents, and the ACP transport ccteam hires DSH sessions through",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "ccteam": {
    "engine": "0.10.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run lint:scan && npm run build && vitest run",
    "pack:check": "npm pack --dry-run",
    "lint:scan": "bash scripts/no-persona-scan.sh"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "optionalDependencies": {
    "@ccteam/engine-darwin-arm64": "0.10.3",
    "@ccteam/engine-darwin-x64": "0.10.3",
    "@ccteam/engine-linux-arm64": "0.10.3",
    "@ccteam/engine-linux-x64": "0.10.3"
  },
  "bundledDependencies": [
    "@deepseek-ai/schemastery"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "clsx": "^2.1.1",
    "lightningcss": "^1.30.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
