{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": []
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "__CCTEAM_HOOK_SH__ load-context", "timeout": 5},
          {"type": "command", "command": "__CCTEAM_HOOK_SH__ progress-append session_start", "async": true}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "__CCTEAM_HOOK_SH__ progress-append Stop", "async": true}
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt|permission_prompt",
        "hooks": [
          {"type": "command", "command": "__CCTEAM_HOOK_SH__ progress-append notification", "async": true}
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {"type": "command", "command": "__CCTEAM_HOOK_SH__ progress-append PreToolUse", "async": true}
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {"type": "command", "command": "__CCTEAM_HOOK_SH__ intercept-ask", "timeout": 5}
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {"type": "command", "command": "__CCTEAM_HOOK_SH__ progress-append PostToolUse", "async": true}
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {"type": "command", "command": "__CCTEAM_HOOK_SH__ progress-append SubagentStop", "async": true}
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {"type": "command", "command": "__CCTEAM_HOOK_SH__ progress-append SessionEnd", "async": true}
        ]
      }
    ]
  }
}
