[Unit]
# V0.6.1 F130 — `ccteam-imd` binary was folded into `ccteam start`.
# This unit now runs the combined daemon (orchestrator + web + IMD
# supervisor as 3 tokio tasks in one process). Pass `--no-web` /
# `--no-imd` on the ExecStart line if you want to trim a task.
Description=ccteam daemon (orchestrator + web + IM-bot supervisor)
Documentation=https://github.com/yourorg/ccteam/blob/main/crates/ccteam-imd/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/ccteam start
ExecStop=%h/.cargo/bin/ccteam stop
Restart=on-failure
RestartSec=5
# Don't fight with `ccteam start`'s tmux sessions — supervisor cleanup is graceful.
KillSignal=SIGTERM
TimeoutStopSec=20

# Allow daemon to read credentials.json + write heartbeat + tmux send-keys.
ReadWritePaths=%h/.ccteam
ReadOnlyPaths=%h/.ccteam/im/credentials.json
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
