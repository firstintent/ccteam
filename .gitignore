# References cloned for inspiration (not vendored).
# See AGENTS.md §三 vendor 红线: 参考实现不是依赖,不进 ccteam 仓库。
/references/

# Rust build artifacts
/target/
**/*.rs.bk

# Editor / OS noise
.DS_Store
*.swp
*~

# Node tooling caches — the SPA's node_modules lives under
# crates/ccteam-web/web/ (own .gitignore); never track one at the root.
node_modules/

.claude

# Project-local gh CLI config (workspace-level GH_CONFIG_DIR; see .claude/settings.local.json)
.gh/
readme.local.txt

# Host-probe scratch output (per-run logs + cost snapshots from
# scripts/host-probe/run-probes.sh). Real demo GIFs land in
# docs/v0-6-0/demos/ when V0.6.1 records them.
.probe-results/
.ccteam
.codegraph

# Claude Telegram (added by claude-telegram-workspace/install.sh)
.claude/channels/
.claude/settings.local.json

# Local scratch notes (architecture diagrams, ad-hoc analysis)
notes/
graphify-out/

# Version archives + research notes — kept local-only, not tracked (slim the repo)
docs-local/

nohup.out
# Local-only env file — never commit secrets.
.env

# Local skill installs (mattpocock/skills etc.) — prompt-type plugin content
# never enters the ccteam repo (AGENTS.md §三红线).
.agents/
skills-lock.json

# Machine-local notes (machine profiles / calibration numbers never enter the repo)
*.local.md

# Smoke-run artifact: a CWD-rooted `CCTEAM_HOME=<repo>` smoke makes
# ccteam_core::config::config_path resolve to <repo>/config.yaml. Repo root
# is never the real config home (runtime config = ~/.ccteam/config.yaml).
/config.yaml
ccteam-hub/
cleat/
__pycache__/
