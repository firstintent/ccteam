# References cloned for inspiration (not vendored).
# See CLAUDE.md §3.7: 参考实现不是依赖,不进 ccteam 仓库。
/references/

# Rust build artifacts
/target/
**/*.rs.bk

# Editor / OS noise
.DS_Store
*.swp
*~

.claude

# Project-local gh CLI config (workspace-level GH_CONFIG_DIR; see .claude/settings.local.json)
.gh/
readme.local.txt

# Host-probe scratch output (per-run logs + cost snapshots from
# scripts/host-probe/run-probes.sh). Real demo GIFs land in
# docs/v0-6-0/demos/ when V0.6.1 records them.
.probe-results/
.ccteam
.codegraph

# Claude Telegram (added by claude-telegram-workspace/install.sh)
.claude/channels/
.claude/settings.local.json

# Local scratch notes (architecture diagrams, ad-hoc analysis)
notes/
graphify-out/

# Local-only connection config (real host/IP). Keep .env.example tracked.
.env
!.env.example

# Smoke-run artifact: a CWD-rooted `CCTEAM_HOME=<repo>` smoke makes
# ccteam_core::config::config_path resolve to <repo>/config.yaml. Repo root
# is never the real config home (runtime config = ~/.ccteam/config.yaml).
/config.yaml
