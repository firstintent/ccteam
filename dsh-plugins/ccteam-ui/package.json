{
  "name": "@ccteam/ccteam-ui",
  "version": "0.13.0",
  "description": "ccteam inside the DeepSeek Harness: the workbench in DSH web (cross-harness session tree, native-grade chat, one-click spawn), the six ccteam MCP tools for DSH agents, and the ACP transport ccteam hires DSH sessions through",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "ccteam": {
    "engine": "0.13.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run lint:scan && npm run build && vitest run",
    "pack:check": "npm pack --dry-run",
    "lint:scan": "bash scripts/no-persona-scan.sh"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.6-alpha.1"
  },
  "optionalDependencies": {
    "@ccteam/engine-darwin-arm64": "0.13.0",
    "@ccteam/engine-darwin-x64": "0.13.0",
    "@ccteam/engine-linux-arm64": "0.13.0",
    "@ccteam/engine-linux-x64": "0.13.0"
  },
  "bundledDependencies": [
    "@deepseek-ai/schemastery"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-account-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-job-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-terminal-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-file-upload": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-product-analytics": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-trajectory": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-command-feedback": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-commands": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-cordis-host-runner": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-file-reference": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-goal": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-host-plugin-inventory": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-message-feedback": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-office-to-pdf": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-permission-presets": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-plugin-manager": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-plugin-market": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-schedule": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session-reference": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-user-questions": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-util-code-language": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-util-file-drag": "0.2.2-alpha.2",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "clsx": "^2.1.1",
    "lightningcss": "^1.30.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
